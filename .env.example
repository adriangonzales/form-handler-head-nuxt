# API base, called only from the Nuxt server. Use the API's public origin:
# The API builds signed export download links from the host it sees on these requests.
NUXT_API_BASE=http://localhost:8000/api

# Url for generating types from.
API_DOCS_URL=http://localhost:8000/docs/api.json

# Shown in embed snippets and used by the browser-side test-submit tool.
NUXT_PUBLIC_API_PUBLIC_BASE=http://localhost:8000/api

# Password rules shown on the Account page. Match the API: 8 characters outside production; in
# production, for example: "Use at least 12 characters, with upper- and lower-case letters, numbers
# and symbols. Passwords found in known data breaches aren't allowed."
NUXT_PUBLIC_PASSWORD_REQUIREMENTS="Use at least 8 characters."

# Seals the session cookie. At least 32 characters. nuxt-auth-utils generates one in dev if empty.
NUXT_SESSION_PASSWORD=

# Session cookie lifetime in seconds. Keep equal to the API's JWT_REFRESH_TTL (minutes × 60).
NUXT_SESSION_MAX_AGE=604800

# Dashboard test account for Playwright. Create it in the API with `php artisan user:create`.
E2E_EMAIL=
E2E_PASSWORD=

# The API's directory, for the Account tests: they create throwaway users with `php artisan user:create`.
E2E_API_DIR=../form-handler-headless-laravel
